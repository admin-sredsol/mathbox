{
  "name": "mathbox",
  "version": "2.3.1",
  "description": "Presentation-quality WebGL math graphing",
  "repository": {
    "type": "git",
    "url": "https://github.com/unconed/mathbox"
  },
  "module": "./build/esm/index.js",
  "main": "./build/esm/index.js",
  "types": "./build/esm/types.d.ts",
  "files": [
    "src",
    "build",
    "*.md",
    "FUNDING.yml"
  ],
  "scripts": {
    "gh-pages": "gh-pages -d examples",
    "typedoc": "npx typedoc --options ./config/typedoc.json",
    "build:bundle": "webpack --config config/webpack.config.js",
    "build:module": "tsc",
    "build:rollup": "rollup -c rollup.config.js",
    "build": "rm -rf build && concurrently 'npm run build:bundle' 'npm run build:module' 'gulp css'",
    "docs": "npx webpack --config config/webpack.config.docs.js && node build_docs/generate.js > docs/primitives.md",
    "format": "prettier src --check",
    "lint": "eslint \"src/**/*.{ts,js}\" --max-warnings=0",
    "autofix": "npm run format -- --write && npm run lint -- --fix",
    "test": "export CHROME_BIN=$(node -e \"console.log(require('puppeteer').executablePath())\") && webpack --config config/webpack.config.testing.js && karma start --single-run",
    "test:watch": "concurrently 'webpack --watch --config config/webpack.config.testing.js' 'karma start'"
  },
  "prettier": {},
  "dependencies": {
    "css-select": "^4.2.1",
    "lodash": "^4.17.21",
    "shadergraph": "^2.1.3",
    "threestrap": "github:admin-sredsol/threestrap"
  },
  "peerDependencies": {
    "three": "^0.182.0"
  },
  "devDependencies": {
    "@rollup/plugin-alias": "^6.0.0",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@types/jasmine": "^3.10.3",
    "@types/node": "^20.0.0",
    "@types/three": "^0.182.0",
    "@typescript-eslint/eslint-plugin": "^5.14.0",
    "@typescript-eslint/parser": "^5.14.0",
    "concurrently": "^7.0.0",
    "eslint": "^7.28.0",
    "eslint-plugin-jasmine": "^4.1.2",
    "gh-pages": "^3.2.3",
    "gulp": "^4.0.2",
    "gulp-concat": "^2.6.1",
    "jasmine-core": "^3.7.1",
    "karma": "^6.3.3",
    "karma-chrome-launcher": "^3.1.0",
    "karma-jasmine": "^4.0.1",
    "prettier": "2.3.1",
    "puppeteer": "^20.0.0",
    "rollup": "^4.53.5",
    "rollup-plugin-terser": "^7.0.2",
    "three": "^0.182.0",
    "ts-loader": "^9.2.8",
    "typedoc": "^0.23.23",
    "typescript": "5.0.4",
    "webpack": "^5.104.0",
    "webpack-cli": "^4.10.0"
  },
  "author": "Steven Wittens",
  "license": "MIT",
  "keywords": [
    "mathbox",
    "threejs",
    "visualizations",
    "mathematics",
    "webgl"
  ],
  "packageManager": "pnpm@10.19.0+sha512.c9fc7236e92adf5c8af42fd5bf1612df99c2ceb62f27047032f4720b33f8eacdde311865e91c411f2774f618d82f320808ecb51718bfa82c060c4ba7c76a32b8"
}
