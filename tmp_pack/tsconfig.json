{
  "compilerOptions": {
    "outDir": "./build/esm/",
    "noImplicitAny": true,
    "module": "ES2020",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "allowJs": true,
    "moduleResolution": "node",
    "strictNullChecks": true,
    "baseUrl": "./",
    "declaration": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node", "jasmine"],
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}
